# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local. Ask the team lead for the real values.

# ── AI: Alibaba Model Studio (OpenAI-compatible) ─────────────
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://<your-workspace>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen4-max            # drafts, insights, rule extraction
LLM_MODEL_FAST=qwen3.8-max     # quick tagging (thinking off)
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024             # must match vector(1024) in the database

# ── Database: Supabase ───────────────────────────────────────
# Local (Docker): run `npm run db:start` and copy the values it prints.
# Cloud: Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=           # server only, bypasses security rules. Never expose.

# ── make.com webhook ─────────────────────────────────────────
INGEST_SECRET=                 # any long random string; make.com sends it as x-echo-secret
MAKE_PUBLISH_WEBHOOK_URL=      # demo publishing: the custom webhook URL of the make.com "ECHO publish to demo" scenario
APP_URL=                       # public address make.com calls back (e.g. https://echo.vercel.app). Optional on Vercel
